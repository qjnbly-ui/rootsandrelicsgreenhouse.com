---
import { site } from '../data/site';
import SocialIcon from './SocialIcon.astro';
---

<footer class="footer">
  <div class="footer-top">
    <p>See you in<br /><em>the greenhouse.</em></p>
  </div>
  <div class="footer-grid">
    <div class="footer-brand-block">
      <img src={site.logo.light} alt="Roots and Relics Greenhouse" />
      <p>Curated antiques for timeless living. Gather, wander, reminisce, and stay awhile.</p>
      <span>Southern Oregon<br />Approximately ten minutes from Klamath Falls</span>
    </div>
    <nav class="footer-nav" aria-label="Visit Roots and Relics">
      <p>Visit</p>
      <a href="/greenhouse-gatherings/">Greenhouse gatherings</a>
      <a href="/private-showings/">Private showings</a>
      <a href="/before-you-visit/">Before you visit</a>
      <a href="/contact/">Contact</a>
    </nav>
    <nav class="footer-nav" aria-label="Explore Roots and Relics">
      <p>Explore</p>
      <a href="/our-story/">Our story</a>
      <a href="/the-collection/">The collection</a>
      <a href="/shop/">Shop online</a>
      <a href="/gallery/">Gallery</a>
      <a href="/from-the-greenhouse/">From the greenhouse</a>
      <a href="/faq/">FAQ</a>
    </nav>
    <div class="footer-list">
      <p class="footer-list-label">Join our list</p>
      <h3>Notes from the greenhouse.</h3>
      <p>Greenhouse weekends, new arrivals, seasonal happenings, and private showing opportunities.</p>
      <a href="/join/">Join the list <span>↗</span></a>
    </div>
  </div>
  <div class="footer-contact">
    <a href={`sms:${site.contact.phoneHref}`}>Text {site.contact.phoneDisplay}</a>
    <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
    <a class="social-contact" href={`https://instagram.com/${site.contact.instagram}`} target="_blank" rel="noopener">
      <SocialIcon platform="instagram" /><span>Instagram</span>
    </a>
    <a class="social-contact" href={site.contact.facebook} target="_blank" rel="noopener noreferrer">
      <SocialIcon platform="facebook" /><span>Facebook</span>
    </a>
  </div>
  <div class="footer-legal">
    <p>© 2026 Roots &amp; Relics. All rights reserved.</p>
    <div class="footer-traffic-counter" data-n3xra-traffic-counter="24b3e993-ac88-4287-8513-d8a61a125589" hidden>
      <span data-n3xra-counter-value></span>
      <span class="footer-traffic-counter-copy">site visits</span>
      <span class="footer-traffic-counter-service-label" data-n3xra-counter-label></span>
    </div>
    <p>Designed &amp; Built by <a href="https://n3xra.com" target="_blank" rel="noopener">N3XRA</a></p>
  </div>
</footer>

<style>
  @media (min-width: 901px) {
    .footer { padding: 32px clamp(32px, 6vw, 104px) 20px; }
    .footer-top { display: none; }
    .footer-grid {
      display: grid;
      grid-template-columns: 1.1fr .8fr .8fr 1.2fr;
      gap: clamp(20px, 4vw, 72px);
      padding: 0 0 22px;
    }
    .footer-brand-block, .footer-nav, .footer-list { text-align: left; align-items: flex-start; }
    .footer-brand-block { display: block; grid-column: auto; }
    .footer-brand-block img { width: 92px; margin: 0 0 10px; }
    .footer-brand-block p { display: none; }
    .footer-brand-block span { display: block; font-size: 10px; }
    .footer-nav p, .footer-list-label { margin-bottom: 10px; }
    .footer-nav a { margin: 0; padding: 2px 0; line-height: 1.45; }
    .footer-list { grid-column: auto; }
    .footer-list h3 { font-size: 26px; margin: 0 0 6px; }
    .footer-list > p:not(.footer-list-label) { font-size: 14px; margin: 0 0 12px; }
    .footer-list > a { min-height: 36px; padding: 0 12px; }
    .footer-contact { padding: 11px 0; gap: 16px; background: transparent; border-block: 1px solid rgba(255,255,255,.2); }
    .footer-contact a { margin: 0; }
    .footer-legal { padding-top: 12px; }
    .footer-legal p { margin: 0; }
  }
</style>
