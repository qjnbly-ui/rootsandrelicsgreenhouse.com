---
interface Props { platform: 'facebook' | 'instagram' }
const { platform } = Astro.props;
---
<svg class="social-platform-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {platform === 'instagram' ? <>
    <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8" />
    <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8" />
    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" />
  </> : <path fill="currentColor" d="M14.1 22v-9.1h3.1l.5-3.6h-3.6V7c0-1 .3-1.8 1.8-1.8H18V2.1c-.4-.1-1.7-.1-3.1-.1-3 0-5 1.8-5 5.2v2.1H6.7v3.6h3.2V22z" />}
</svg>
<style>.social-platform-icon { display:inline-block; flex:none; vertical-align:middle; }</style>
