---
import { site, type SitePath } from '../data/site';

interface Props {
  currentPath?: SitePath;
}

const { currentPath = '/' } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '');
const onSignupPage = path === '/join';
const isCurrent = (href: SitePath) =>
  (currentPath === href || path === href.replace(/\/$/, '')) ? 'page' : undefined;
const portalUrl = 'https://roots-and-relics-be7315.portal.n3xra.com';
const mainLinks = [
  { label: 'Visit', href: '/before-you-visit/' },
  { label: 'Shop', href: '/shop/' },
  { label: 'Gatherings', href: '/greenhouse-gatherings/' },
] as const;
const mainPaths = new Set<SitePath>(mainLinks.map(({ href }) => href));
const exploreLinks = [...site.primaryNavigation, ...site.secondaryNavigation].filter(({ href }) => !mainPaths.has(href));
---

<header class="header rr-header" data-header>
  <a class="brand" href="/" aria-label="Roots and Relics home">
    <img src={site.logo.light} alt="Roots and Relics Greenhouse" />
  </a>
  <nav class="rr-desktop-nav" aria-label="Main navigation">
    {mainLinks.map(({ href, label }) => (
      <a class="rr-desktop-link" href={href} aria-current={isCurrent(href)}>{label}</a>
    ))}
    <button class="rr-nav-toggle rr-desktop-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle="desktop">
      <span>Explore</span>
    </button>
  </nav>
  <a class="rr-login rr-login-desktop" href={portalUrl}>Log in</a>
  <button class="rr-nav-toggle rr-mobile-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle="mobile">
    <span>Menu</span>
  </button>

  <nav id="site-nav" class="rr-panel" aria-label="Explore Roots and Relics">
    <div class="rr-panel-content">
      <div class="rr-panel-primary">
        {mainLinks.map(({ href, label }) => (
          <a href={href} aria-current={isCurrent(href)}>{label}</a>
        ))}
      </div>
      <div class="rr-panel-explore">
        <p>Explore</p>
        <div class="rr-panel-links">
          {exploreLinks.map(({ href, label }) => (
            <a href={href} aria-current={isCurrent(href)}>{label}</a>
          ))}
        </div>
      </div>
      <div class="rr-panel-actions">
        <a class="rr-updates" href="/join/" aria-current={onSignupPage ? 'page' : undefined}>Sign up for updates</a>
        <a class="rr-login" href={portalUrl}>Log in</a>
      </div>
    </div>
  </nav>
</header>

<style>
  .rr-header { grid-template-columns: minmax(0,1fr) auto minmax(0,1fr); column-gap: 16px; }
  .rr-header .brand { position: relative; z-index: 3; justify-self: start; }
  .rr-desktop-nav { position: relative; z-index: 3; display: flex; align-items: center; gap: clamp(22px,3.5vw,56px); }
  .rr-desktop-link, .rr-nav-toggle, .rr-login { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; white-space: nowrap; }
  .rr-desktop-link, .rr-nav-toggle { color: inherit; font: 400 11px var(--mono); text-transform: uppercase; letter-spacing: .12em; text-decoration: none; }
  .rr-desktop-link:hover, .rr-nav-toggle:hover, .rr-desktop-link[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
  .rr-nav-toggle { position: relative; z-index: 3; background: none; border: 0; padding: 0; cursor: pointer; }
  .rr-mobile-toggle { display: none; }
  .rr-login { border: 1px solid rgba(246,236,210,.65); border-radius: 999px; padding: 0 21px; background: rgba(34,46,26,.72); color: #faf3e3; text-decoration: none; font: 500 14px var(--sans); transition: background .2s, color .2s, border-color .2s; }
  .rr-login:hover { border-color: var(--paper); background: var(--paper); color: var(--forest); }
  .rr-login-desktop { justify-self: end; }
  .rr-header a:focus-visible, .rr-header button:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }

  .rr-panel { position: fixed; z-index: 2; inset: 0 0 auto; height: 100dvh; overflow-y: auto; overscroll-behavior: contain; display: flex; flex-direction: column; align-items: center; padding: clamp(104px,16vh,155px) 6vw max(34px,env(safe-area-inset-bottom)); background: var(--forest); color: var(--paper); text-align: center; visibility: hidden; }
  .rr-header.is-open .rr-panel { visibility: visible; }
  .rr-header.is-open .rr-desktop-nav { position: static; grid-column: 2; align-self: center; justify-self: center; }
  .rr-header.is-open .rr-desktop-link, .rr-header.is-open .rr-login-desktop { display: none; }
  .rr-panel-content { width: min(100%,640px); margin-block: auto; }
  .rr-panel-primary { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px clamp(24px,5vw,48px); }
  .rr-panel-primary a { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; font: 300 clamp(34px,5vw,58px)/1 var(--serif); white-space: nowrap; }
  .rr-panel-primary a, .rr-panel-links a, .rr-updates { color: inherit; text-decoration: none; }
  .rr-panel-primary a:hover, .rr-panel-links a:hover, .rr-updates:hover, .rr-panel a[aria-current="page"] { text-decoration: underline; text-underline-offset: 5px; }
  .rr-panel-explore { margin-top: clamp(16px,4vh,37px); padding-top: clamp(13px,3vh,26px); border-top: 1px solid rgba(255,255,255,.22); }
  .rr-panel-explore p { margin: 0 0 8px; color: var(--gold); font: 400 10px var(--mono); letter-spacing: .17em; text-transform: uppercase; }
  .rr-panel-links { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); column-gap: 8px; }
  .rr-panel-links a, .rr-updates { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 6px 2px; font: 500 15px/1.25 var(--sans); }
  .rr-panel-actions { display: flex; justify-content: center; align-items: center; gap: 11px 25px; flex-wrap: wrap; margin-top: clamp(12px,3vh,24px); }
  .rr-panel-actions .rr-login { min-width: 110px; border-color: var(--cream); background: var(--cream); color: var(--forest); }
  .rr-panel-actions .rr-login:hover { border-color: var(--gold); background: var(--gold); }
  .rr-panel-actions .rr-login:focus-visible { outline-color: var(--paper); }
  .rr-updates { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) {
    .rr-header { grid-template-columns: 1fr auto; }
    .rr-desktop-nav, .rr-login-desktop, .rr-header.is-open .rr-desktop-nav { display: none; }
    .rr-mobile-toggle { display: inline-flex; border: 1px solid rgba(246,236,210,.58); border-radius: 999px; padding: 0 15px; }
    .rr-panel { padding-top: 96px; }
  }
  @media (max-width: 480px) {
    .rr-panel-primary { flex-direction: column; gap: 0; }
    .rr-panel-links { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
</style>
