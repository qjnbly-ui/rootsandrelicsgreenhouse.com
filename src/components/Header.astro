---
import { site, type SitePath } from '../data/site';

interface Props {
  currentPath?: SitePath;
}

const { currentPath = '/' } = Astro.props;
const onSignupPage = Astro.url.pathname.replace(/\/$/, '') === '/join';
const isCurrent = (href: SitePath) => currentPath === href;
---

<header class="header" data-header>
  <a class="brand" href="/" aria-label="Roots and Relics home">
    <img src={site.logo.light} alt="Roots and Relics Greenhouse" />
  </a>
  <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
    <span>Menu</span><i></i><i></i>
  </button>
  <nav id="site-nav" class="nav" aria-label="Main navigation">
    {site.primaryNavigation.map((item) => (
      <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    {site.secondaryNavigation.map((item) => (
      <a class="nav-mobile-only" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
    ))}
    <a class="nav-mobile-only" href="/join/" aria-current={onSignupPage ? 'page' : undefined}>Sign up for updates</a>
    <a class="nav-mobile-only login-link" href="https://roots-and-relics-be7315.portal.n3xra.com">Login</a>
  </nav>
  <a class="login-link login-desktop" href="https://roots-and-relics-be7315.portal.n3xra.com">Login</a>
  <a class="header-cta" href="/join/" aria-current={onSignupPage ? 'page' : undefined}>Sign up for updates</a>
</header>

<style>
  .login-link {
    color: inherit;
    text-decoration: none;
    text-transform: none;
  }
  .login-desktop {
    padding: 10px 5px;
    font: 500 14px var(--sans);
  }
  .login-link:hover { text-decoration: underline; text-underline-offset: 4px; }
  @media (max-width: 900px) { .login-desktop { display: none; } }
</style>
