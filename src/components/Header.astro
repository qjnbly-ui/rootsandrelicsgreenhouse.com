---
import { site, type SitePath } from '../data/site';

interface Props {
  currentPath?: SitePath;
}

const { currentPath = '/' } = Astro.props;
const onSignupPage = Astro.url.pathname.replace(/\/$/, '') === '/join';
const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: SitePath) =>
  (currentPath === href || path === href.replace(/\/$/, '')) ? 'page' : undefined;
const portalUrl = 'https://roots-and-relics-be7315.portal.n3xra.com';
const mainLinks = [
  { label: 'Visit', href: '/before-you-visit/' },
  { label: 'Shop', href: '/shop/' },
  { label: 'Gatherings', href: '/greenhouse-gatherings/' },
] as const;
const mainPaths = new Set<SitePath>(mainLinks.map(({ href }) => href));
const exploreLinks = [...site.primaryNavigation, ...site.secondaryNavigation].filter(({ href }) => !mainPaths.has(href));
---

<header class="header rr-header" data-header>
  <a class="brand" href="/" aria-label="Roots and Relics home">
    <img src={site.logo.light} alt="Roots and Relics Greenhouse" />
  </a>
  <button class="menu-button rr-menu" type="button" aria-expanded="false" aria-controls="site-nav" data-menu>
    <span>Menu</span>
  </button>
  <nav id="site-nav" class="rr-nav" aria-label="Main navigation">
    {mainLinks.map(({ href, label }) => (
      <a class="rr-primary" href={href} aria-current={isCurrent(href)}>{label}</a>
    ))}
    <div class="rr-explore" data-explore>
      <button class="rr-explore-toggle" type="button" aria-expanded="false" aria-controls="site-explore" data-explore-toggle>
        Explore <span aria-hidden="true">⌄</span>
      </button>
      <p class="rr-explore-label">Explore</p>
      <div id="site-explore" class="rr-explore-links">
        {exploreLinks.map(({ href, label }) => (
          <a href={href} aria-current={isCurrent(href)}>{label}</a>
        ))}
        <a class="rr-updates" href="/join/" aria-current={onSignupPage ? 'page' : undefined}>Sign up for updates</a>
      </div>
    </div>
    <a class="rr-login rr-login-mobile" href={portalUrl}>Log in</a>
  </nav>
  <a class="rr-login rr-login-desktop" href={portalUrl}>Log in</a>
</header>

<style>
  .rr-header { grid-template-columns: minmax(100px,1fr) auto minmax(100px,1fr); column-gap: 16px; }
  .rr-header .brand { justify-self: start; }
  .rr-nav { display: flex; align-items: center; justify-content: center; gap: clamp(20px,3vw,48px); }
  .rr-nav a, .rr-login { color: inherit; text-decoration: none; }
  .rr-primary, .rr-explore-toggle { font: 400 11px var(--mono); text-transform: uppercase; letter-spacing: .09em; white-space: nowrap; }
  .rr-primary, .rr-explore-toggle, .rr-login { display: inline-flex; align-items: center; min-height: 44px; }
  .rr-login { font: 500 14px var(--sans); padding: 0 5px; white-space: nowrap; }
  .rr-login-desktop { justify-self: end; }
  .rr-nav a:hover, .rr-login:hover, .rr-nav a[aria-current="page"] { text-decoration: underline; text-underline-offset: 4px; }
  .rr-nav a:focus-visible, .rr-login:focus-visible, .rr-explore-toggle:focus-visible, .rr-menu:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .rr-explore { position: relative; }
  .rr-explore-toggle { gap: 5px; background: none; color: inherit; border: 0; padding: 0; cursor: pointer; }
  .rr-explore-toggle span { font-size: 16px; line-height: 1; }
  .rr-explore-toggle[aria-expanded="true"] span { transform: rotate(180deg); }
  .rr-explore-label, .rr-login-mobile { display: none; }
  .rr-explore-links { display: none; position: absolute; inset: 100% 0 auto auto; min-width: 210px; max-height: 75dvh; overflow-y: auto; padding: 10px 16px; border: 1px solid var(--line); background: var(--paper); color: var(--forest); box-shadow: 0 18px 35px rgba(25,30,18,.2); }
  .rr-explore-toggle[aria-expanded="true"] ~ .rr-explore-links { display: grid; }
  .rr-explore-links a { display: flex; align-items: center; min-height: 40px; font: 500 14px var(--sans); }
  .rr-explore-links .rr-updates { margin-top: 5px; border-top: 1px solid var(--line); }
  @media (max-width: 900px) {
    .rr-header { grid-template-columns: 1fr auto; }
    .rr-menu { min-height: 44px; }
    .rr-login-desktop, .rr-explore-toggle { display: none; }
    .rr-nav { position: fixed; z-index: 2; inset: 0 0 auto; width: 100%; height: 100dvh; overflow-y: auto; overscroll-behavior: contain; align-items: stretch; justify-content: flex-start; flex-direction: column; gap: 0; padding: 96px 7vw max(34px, env(safe-area-inset-bottom)); background: var(--forest); visibility: hidden; }
    .rr-nav.is-open { visibility: visible; }
    .rr-primary { min-height: 48px; font: 300 30px/1.1 var(--serif); text-transform: none; letter-spacing: 0; }
    .rr-explore { margin-top: 12px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,.25); }
    .rr-explore-label { display: block; margin: 0 0 3px; color: var(--gold); font: 400 11px var(--mono); letter-spacing: .12em; text-transform: uppercase; }
    .rr-explore-links, .rr-explore-toggle[aria-expanded="true"] ~ .rr-explore-links { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 12px; position: static; min-width: 0; max-height: none; overflow: visible; padding: 0; border: 0; background: none; color: inherit; box-shadow: none; }
    .rr-explore-links a { min-height: 44px; }
    .rr-explore-links .rr-updates { margin: 0; border: 0; }
    .rr-login-mobile { display: flex; margin-top: 9px; padding: 0; border-top: 1px solid rgba(255,255,255,.25); }
  }
</style>
