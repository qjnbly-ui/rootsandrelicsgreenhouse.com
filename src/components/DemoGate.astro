---
import { site } from '../data/site';
---

<div class="demo-gate" data-demo-gate role="dialog" aria-modal="true" aria-labelledby="demo-gate-title" aria-describedby="demo-gate-copy">
  <div class="demo-gate-inner">
    <img class="demo-gate-logo" src={site.logo.light} alt="Roots and Relics Greenhouse" />
    <p class="demo-gate-kicker">Website preview</p>
    <h2 id="demo-gate-title">Welcome to<br /><em>the demo.</em></h2>
    <p id="demo-gate-copy" class="demo-gate-copy">This is a demonstration—not the complete website. Some pages, imagery, and features are still being thoughtfully built.</p>
    <button class="demo-gate-enter" type="button" data-demo-enter aria-label="Enter the website demo">
      <span class="demo-gate-enter-top">Click to</span>
      <strong>Enter</strong>
      <span class="demo-gate-enter-bottom">the demo <b aria-hidden="true">→</b></span>
    </button>
    <p class="demo-gate-credit">A custom website preview by N3XRA</p>
  </div>
</div>
