---
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const calendarUrl = 'https://n3xra.com/calendar/app/?public=769ae412-4e58-5178-bcb5-952ba663105b&theme=light';
---
<section class:list={['gatherings-calendar', { 'gatherings-calendar-compact': compact }]} aria-labelledby="public-calendar-title">
  <header class="gatherings-calendar-heading">
    <p class="kicker">Dates from the greenhouse</p>
    <h2 id="public-calendar-title">A little room<br />for <em>gathering.</em></h2>
    <p>Browse our market dates and opening hours. November and December gatherings are save-the-date entries; opening hours will follow.</p>
  </header>
  <iframe src={`${calendarUrl}&embed=1`} title="Roots & Relics public events calendar" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
  <div class="gatherings-calendar-links">
    <a class="action-link action-link-dark" href={calendarUrl} target="_blank" rel="noopener">Open calendar <span aria-hidden="true">↗</span></a>
    <a class="action-link action-link-dark" href="/calendar/roots-relics-markets-2026.ics" download>Save published dates <span aria-hidden="true">↓</span></a>
  </div>
  <details class="gatherings-calendar-fallback">
    <summary>See the published dates as a list</summary>
    <ul>
      <li><strong>Fall Gathering · October 8–11</strong><span>Thursday 3–7 PM · Friday 10 AM–6 PM · Saturday 9 AM–5 PM · Sunday 10 AM–3 PM</span></li>
      <li><strong>Holiday Greenhouse · November 27–29</strong><span>Opening hours to be announced.</span></li>
      <li><strong>Christmas Market · December 10–13</strong><span>Opening hours to be announced.</span></li>
      <li><strong>The Eleventh Hour Market · December 23</strong><span>Opening hours to be announced.</span></li>
    </ul>
    <p>All dates are in 2026. All opening hours use Pacific time.</p>
  </details>
</section>
<style>
.gatherings-calendar{padding:90px clamp(20px,6vw,90px);background:#f4f2e9;color:#26321e}.gatherings-calendar-heading{max-width:650px;margin-bottom:35px}.gatherings-calendar-heading h2{font-family:Newsreader,Georgia,serif;font-weight:400;font-size:clamp(42px,5vw,68px);line-height:1.05;margin:18px 0}.gatherings-calendar-heading>p:last-child{line-height:1.8;max-width:580px}.gatherings-calendar iframe{display:block;width:100%;height:850px;border:1px solid #ced2c3;border-radius:8px;background:#faf9f4}.gatherings-calendar-links{display:flex;flex-wrap:wrap;gap:30px;margin-top:25px}.gatherings-calendar-fallback{margin-top:30px;border-top:1px solid #ced2c3;padding-top:20px;font-size:14px}.gatherings-calendar-fallback summary{cursor:pointer;padding:10px 0}.gatherings-calendar-fallback ul{list-style:none;padding:0}.gatherings-calendar-fallback li{padding:15px 0;border-bottom:1px solid #d7dacd}.gatherings-calendar-fallback li span{display:block;margin-top:8px;line-height:1.8}@media(max-width:700px){.gatherings-calendar{padding:55px 20px}.gatherings-calendar iframe{height:880px}}
</style>
