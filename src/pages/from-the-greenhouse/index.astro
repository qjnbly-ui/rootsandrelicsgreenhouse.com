---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { imageUrl } from '../../lib/image-assets';
import '../../styles/from-the-greenhouse.css';

const fallbackHero = imageUrl('r-r-greenhousse-13.jpg');
---

<BaseLayout
  title="From the Greenhouse | Roots & Relics"
  description="New pieces, farm stories, gathered moments, and notes from Roots & Relics Greenhouse."
  currentPath="/from-the-greenhouse/"
  bodyClass="greenhouse-journal-page inner-page"
>
  <main id="main" class="greenhouse-journal">
    <section class="greenhouse-journal-hero">
      <img id="journal-hero-image" src={fallbackHero} alt="A view inside Roots and Relics Greenhouse" fetchpriority="high" />
      <div class="greenhouse-journal-hero-shade" aria-hidden="true"></div>
      <div class="greenhouse-journal-hero-copy">
        <p class="kicker" id="journal-kicker">New pieces · farm stories · gathered moments</p>
        <h1 id="journal-title">From the <em>greenhouse.</em></h1>
        <p id="journal-intro">A living journal from Roots &amp; Relics—new finds, greenhouse days, and the stories that follow pieces home.</p>
      </div>
    </section>

    <section class="greenhouse-journal-feed" aria-labelledby="journal-feed-title">
      <header class="greenhouse-journal-heading">
        <p class="kicker">The latest from Roots &amp; Relics</p>
        <h2 id="journal-feed-title">Stories worth <em>keeping.</em></h2>
      </header>
      <div class="greenhouse-journal-status" id="journal-status" role="status">Gathering the latest notes…</div>
      <div class="greenhouse-journal-grid" id="journal-grid" hidden></div>
    </section>

    <section class="greenhouse-journal-invitation" id="share-your-find">
      <div class="greenhouse-share-intro"><p class="kicker">A piece found its place?</p><h2>We would love to see it <em>at home.</em></h2><p>Share a photograph and the story of what caught your eye. Jennifer and Pat will review it before anything appears publicly.</p></div>
      <form class="greenhouse-share-form" id="share-find-form">
        <label><span>Your name</span><input name="name" maxlength="160" required autocomplete="name" /></label>
        <label><span>Your email</span><input name="email" type="email" maxlength="320" required autocomplete="email" /></label>
        <label class="greenhouse-share-wide"><span>Story title <small>optional</small></span><input name="title" maxlength="180" placeholder="The piece that found its place" /></label>
        <label class="greenhouse-share-wide"><span>Your story</span><textarea name="story" maxlength="5000" rows="6" required placeholder="Tell us what you found and where it lives now."></textarea></label>
        <label class="greenhouse-share-wide greenhouse-share-photo"><span>Photograph</span><input name="photo" type="file" accept="image/jpeg,image/png,image/webp,image/gif" required /><small>JPG, PNG, WebP, or GIF up to 10 MB. Your photo stays private until reviewed.</small></label>
        <label class="greenhouse-share-wide greenhouse-share-check"><input name="permission" type="checkbox" required /><span>I took this photo or have permission to share it, and I give Roots &amp; Relics permission to publish this story and photograph.</span></label>
        <label class="greenhouse-share-honey" aria-hidden="true"><span>Company</span><input name="company" tabindex="-1" autocomplete="off" /></label>
        <div class="greenhouse-share-wide greenhouse-share-action"><button type="submit">Share your find <span>→</span></button><p id="share-find-status" role="status" aria-live="polite"></p></div>
      </form>
    </section>
  </main>

  <script src="../../scripts/from-the-greenhouse.ts"></script>
</BaseLayout>
