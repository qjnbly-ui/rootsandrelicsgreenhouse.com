---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';
import { fallGathering } from '../../data/events';
import { imageUrl } from '../../lib/image-assets';
import '../../styles/gatherings.css';

const gatheringHighlights = [
  {
    title: 'A newly arranged greenhouse',
    description: 'Freshly sourced pieces are brought in, displays are rebuilt, and the whole space is readied for another weekend.',
    image: '226-browsing-green-cabinet.webp',
    alt: 'A guest browsing an antique green cabinet in the newly arranged greenhouse',
    position: '50% 48%',
  },
  {
    title: 'Something good on the table',
    description: 'Refreshments are part of the welcome—an invitation to pause, catch up, and make the visit last a little longer.',
    image: '106-refreshments-pastries.jpg',
    alt: 'Pastries and small treats arranged on antique serving pieces',
    position: '50% 50%',
  },
  {
    title: 'Flowers & seasonal touches',
    description: 'The details follow the season, from overflowing summer blooms to gathered branches and quieter winter greens.',
    image: '120-garden-cart-planted.jpg',
    alt: 'An antique iron garden cart planted with seasonal herbs and flowers',
    position: '50% 50%',
  },
];

const upcomingGatherings = [
  {
    title: fallGathering.title,
    month: 'October',
    days: '8–11',
    datetime: '2026-10-08',
    calendar: fallGathering.calendar,
    image: fallGathering.image,
    alt: fallGathering.imageAlt,
    position: '52% 58%',
    stamp: 'Gathered',
    stampDetail: 'for autumn',
  },
  {
    title: 'Holiday Greenhouse',
    month: 'November',
    days: '27–29',
    datetime: '2026-11-27',
    calendar: '/calendar/holiday-greenhouse-2026.ics',
    image: '85-vignette-wooden-tools.jpg',
    alt: 'Antique wooden kitchen tools gathered in an old wooden firkin',
    position: '51% 58%',
    stamp: 'Warmly',
    stampDetail: 'for the holidays',
  },
  {
    title: 'Christmas Market',
    month: 'December',
    days: '10–13',
    datetime: '2026-12-10',
    calendar: '/calendar/christmas-market-2026.ics',
    image: '86-vignette-thread.jpg',
    alt: 'A red and gold striped vintage umbrella resting on an antique wooden surface',
    position: '54% 58%',
    stamp: 'Merry',
    stampDetail: '& bright',
  },
  {
    title: 'The Eleventh Hour Market',
    month: 'December',
    days: '23',
    datetime: '2026-12-23',
    calendar: '/calendar/eleventh-hour-market-2026.ics',
    note: "Come by, we'll help you pull it off.",
    image: '92-vignette-still-life.jpg',
    alt: 'An antique clock, dried botanicals, and a brass swan arranged in a greenhouse vignette',
    position: '46% 48%',
    stamp: 'Last call',
    stampDetail: "we'll help",
  },
];

const fallGatheringSchema = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `${fallGathering.title} at Roots & Relics Greenhouse`,
  description: fallGathering.description,
  startDate: '2026-10-08T15:00:00-07:00',
  endDate: '2026-10-11T15:00:00-07:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  image: [imageUrl(fallGathering.image)],
  url: `https://www.rootsandrelicsgreenhouse.com${fallGathering.href}`,
  location: {
    '@type': 'Place',
    name: 'Roots & Relics Greenhouse',
    address: {
      '@type': 'PostalAddress',
      addressRegion: 'OR',
      addressCountry: 'US',
    },
  },
  organizer: {
    '@type': 'Organization',
    name: 'Roots & Relics Greenhouse',
    url: 'https://www.rootsandrelicsgreenhouse.com/',
  },
};
---

<BaseLayout
  title="Greenhouse Gatherings | Roots & Relics Greenhouse"
  description="Spend the day at a select Roots & Relics Greenhouse market weekend in Southern Oregon, with newly arranged antiques, refreshments, flowers, and seasonal details."
  currentPath="/greenhouse-gatherings/"
  bodyClass="gatherings-page"
>
  <main id="main" class="gatherings-main">
    <section class="gatherings-hero" aria-labelledby="gatherings-title">
      <figure class="gatherings-hero-image reveal">
        <img src={imageUrl('r-r-greenhousse-5.jpg')} alt="Sunlight, hanging flowers, and collected furniture inside the greenhouse" />
      </figure>
      <div class="gatherings-hero-card">
        <p class="kicker reveal">Select market weekends · Southern Oregon</p>
        <h1 id="gatherings-title" class="reveal">Come spend<br />the day <em>with us.</em></h1>
      </div>
    </section>

    <section class="fall-gathering-feature" id={fallGathering.id} aria-labelledby="fall-gathering-title">
      <div class="fall-gathering-feature-heading reveal">
        <div>
          <p class="kicker">{fallGathering.eyebrow}</p>
          <p class="fall-gathering-date">{fallGathering.dateLabel}</p>
        </div>
        <h2 id="fall-gathering-title">Fall<br /><em>Gathering.</em></h2>
        <p class="fall-gathering-lead">{fallGathering.description}</p>
      </div>

      <div class="fall-gathering-feature-body">
        <figure class="fall-gathering-feature-image reveal">
          <img src={imageUrl(fallGathering.image)} alt={fallGathering.imageAlt} loading="lazy" decoding="async" />
          <figcaption>Gathered for autumn.</figcaption>
        </figure>

        <div class="fall-gathering-schedule reveal" aria-label="Fall Gathering schedule">
          {fallGathering.schedule.map((opening) => (
            <article class:list={['fall-gathering-opening', { 'is-special': opening.emphasis }]}>
              <p>{opening.label}</p>
              <div>
                <h3>{opening.day}</h3>
                <time datetime={opening.start}>{opening.hours}</time>
              </div>
              {'note' in opening && opening.note && <p class="fall-gathering-opening-note">{opening.note}</p>}
            </article>
          ))}
        </div>
      </div>

      <div class="fall-gathering-visit reveal">
        <div class="fall-gathering-visit-heading">
          <p class="kicker">Before you make the drive</p>
          <h3>A few things<br /><em>to know.</em></h3>
        </div>
        <ul>
          {fallGathering.visitNotes.map((note) => <li>{note}</li>)}
        </ul>
        <div class="fall-gathering-actions">
          <a class="solid-link" href={fallGathering.calendar} download>Save all four days <span>↓</span></a>
          <a class="action-link fall-gathering-secondary" href="/join/">Get gathering updates <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="gatherings-dates" aria-labelledby="gatherings-dates-title">
      <header class="gatherings-dates-heading reveal">
        <div>
          <p class="kicker">The dates are set</p>
          <h2 id="gatherings-dates-title">Keep these<br /><em>weekends open.</em></h2>
        </div>
        <div class="gatherings-dates-intro">
          <p>Fall Gathering details are here now. Hours and thoughtful details for the remaining markets will be shared as each weekend gets closer.</p>
          <a class="action-link action-link-dark" href="/calendar/roots-relics-markets-2026.ics" download>Save all four dates <span>↓</span></a>
        </div>
      </header>

      <div class="gatherings-date-list">
        {upcomingGatherings.map((gathering) => (
          <article class="gatherings-date-row reveal">
            <figure class="gatherings-date-image">
              <img src={imageUrl(gathering.image)} alt={gathering.alt} loading="lazy" style={`object-position:${gathering.position}`} />
            </figure>
            <div class="gatherings-date-name">
              <h3>{gathering.title}</h3>
              <time datetime={gathering.datetime}><span>{gathering.month}</span> <em>{gathering.days}</em></time>
              {gathering.note && <p>{gathering.note}</p>}
            </div>
            <div class="gatherings-date-footer">
              <a href={gathering.calendar} download aria-label={`Save ${gathering.title} to your calendar`}>
                Save the date <span>↓</span>
              </a>
              <span class="gatherings-date-stamp" aria-hidden="true">
                <small>Roots &amp; Relics</small>
                <b>{gathering.stamp}</b>
                <strong>{gathering.stampDetail}</strong>
                <i>Southern Oregon</i>
              </span>
            </div>
          </article>
        ))}
      </div>

      <p class="gatherings-dates-note reveal">Fall Gathering is ready for your calendar. Keep the remaining weekends open, too.</p>
    </section>

    <section class="gatherings-story" id="gathering-story" aria-labelledby="gathering-story-title">
      <div class="gatherings-story-heading reveal">
        <p class="kicker">Worth waiting for</p>
        <h2 id="gathering-story-title">We do not open<br />every weekend.<br /><em>That is intentional.</em></h2>
      </div>
      <div class="gatherings-story-copy reveal">
        <p>Each gathering takes time to prepare. New finds arrive, displays shift, flowers are brought in, and thoughtful details begin to appear throughout the greenhouse.</p>
        <p>Opening less often gives every weekend its own energy—and gives guests something genuinely new to walk into.</p>
      </div>
      <div class="gatherings-story-images">
        <figure class="gatherings-story-large reveal">
          <img src={imageUrl('113-gathering-counter.jpg')} alt="The greenhouse counter prepared for guests during a market weekend" loading="lazy" />
        </figure>
        <figure class="gatherings-story-small reveal">
          <img src={imageUrl('104-refreshments-table.jpg')} alt="A welcoming table of refreshments inside the greenhouse" loading="lazy" />
          <figcaption>Prepared for company.</figcaption>
        </figure>
      </div>
    </section>

    <section class="gatherings-includes" aria-labelledby="gatherings-includes-title">
      <header class="gatherings-includes-heading reveal">
        <p class="kicker">A gathering includes</p>
        <h2 id="gatherings-includes-title">The doors open.<br /><em>The day unfolds.</em></h2>
        <p>There is no prescribed route and no need to hurry. Browse, visit, circle back, and stay as long as the day allows.</p>
      </header>

      <div class="gatherings-highlight-grid">
        {gatheringHighlights.map((highlight) => (
          <article class="gatherings-highlight reveal">
            <figure>
              <img
                src={imageUrl(highlight.image)}
                alt={highlight.alt}
                loading="lazy"
                style={`object-position:${highlight.position}`}
              />
            </figure>
            <div class="gatherings-highlight-copy">
              <h3>{highlight.title}</h3>
              <p>{highlight.description}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="gatherings-tradition" aria-labelledby="tradition-title">
      <figure class="gatherings-tradition-image reveal">
        <img src={imageUrl('221-gathering-food-baskets.webp')} alt="Friends browsing collected antiques beneath hanging flower baskets during a greenhouse gathering" loading="lazy" />
      </figure>
      <div class="gatherings-tradition-copy reveal">
        <p class="kicker">More than a market</p>
        <h2 id="tradition-title">Some arrive with a list.<br /><em>Others come for the tradition.</em></h2>
        <p>Both are welcome. The best gathering days leave room for a lucky find, a long conversation, and the pleasure of seeing who else walked through the door.</p>
      </div>
    </section>

    <section class="gatherings-visit" aria-labelledby="gatherings-visit-title">
      <figure class="gatherings-visit-image reveal">
        <img src={imageUrl('110-sign-welcome-outdoor.jpg')} alt="A welcome sign outside the open Roots and Relics greenhouse" loading="lazy" />
        <figcaption>Come on in. Take your time.</figcaption>
      </figure>
      <div class="gatherings-visit-copy reveal">
        <p class="kicker">Before you come</p>
        <h2 id="gatherings-visit-title">Southern Oregon,<br /><em>ten minutes from town.</em></h2>
        <p>To preserve the experience and privacy of the farm, the exact address is shared shortly before gatherings or with confirmed private appointments.</p>
        <ul>
          <li>Comfortable shoes are encouraged.</li>
          <li>Children are welcome with supervision.</li>
          <li>Bring a larger vehicle if you hope to purchase furniture.</li>
        </ul>
        <div class="gatherings-visit-actions">
          <a class="solid-link" href={`sms:${site.contact.phoneHref}`}>Text {site.contact.phoneDisplay} <span>→</span></a>
          <a class="action-link action-link-dark" href="/before-you-visit/">Before you visit <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="gatherings-list" aria-labelledby="gatherings-list-title">
      <div class="gatherings-list-copy reveal">
        <p class="kicker">Be the first to know</p>
        <h2 id="gatherings-list-title">The next greenhouse weekend starts with <em>a note.</em></h2>
        <p>Hear about upcoming gathering dates, newly arrived pieces, seasonal happenings on the farm, and private showing opportunities.</p>
        <div class="gatherings-list-actions">
          <a class="solid-link gatherings-list-primary" href="/join/">Join our list <span>↗</span></a>
          <a class="action-link gatherings-list-secondary" href="/contact/">Contact us <span>→</span></a>
        </div>
      </div>
      <figure class="gatherings-list-image reveal">
        <img src={imageUrl('119-sign-bloom-bar.jpg')} alt="A hand-lettered bloom bar sign for a greenhouse gathering" loading="lazy" />
      </figure>
    </section>
  </main>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(fallGatheringSchema)} />
</BaseLayout>
