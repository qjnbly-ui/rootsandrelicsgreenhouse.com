---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { imageUrl } from '../../lib/image-assets';
import { albums } from '../../data/gallery';
import '../../styles/gallery.css';

export function getStaticPaths() {
  return albums.map((album) => ({ params: { album: album.slug }, props: { album } }));
}
const { album } = Astro.props;
---
<BaseLayout title={`${album.title} | Roots & Relics Gallery`} description={`${album.subtitle}. Browse photographs from Roots & Relics Greenhouse.`} currentPath="/gallery/" bodyClass="gallery-page">
  <main id="main" class="gallery-main" data-gallery-album={album.slug}>
    <section class="gallery-hero gallery-album-hero" aria-labelledby="gallery-title">
      <figure class="gallery-hero-image" aria-hidden="true"><img src={imageUrl(album.cover)} alt="" fetchpriority="high" /></figure>
      <div class="gallery-hero-shade" aria-hidden="true"></div>
      <div class="gallery-hero-content">
        <p class="kicker">{album.subtitle}</p>
        <h1 id="gallery-title">{album.title}</h1>
      </div>

    </section>
    <section class="gallery-collection" aria-label={`${album.title} photographs`}>
      <nav class="gallery-album-tools" aria-label="Album controls">
        <a class="gallery-back" href="/gallery/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14 6-6 6 6 6M8 12h13" /></svg><span>All albums</span></a>
      </nav>
      <p data-gallery-status role="status" aria-live="polite"></p>
      <div class="gallery-grid" data-gallery-grid>
        {album.images.map((image) => (
          <figure class="gallery-image reveal" data-gallery-filename={image.filename}>
            <button type="button" data-gallery-item aria-label={`Open photo: ${image.alt}`}>
              <img src={imageUrl(image.filename)} data-full-src={imageUrl(image.filename)} alt={image.alt} loading="lazy" decoding="async" />
            </button>
          </figure>
        ))}
      </div>
      <p data-gallery-empty hidden>This album has no photos to show just yet. <a href="/gallery/">Explore the other albums.</a></p>
    </section>
    <div class="gallery-lightbox" data-gallery-lightbox hidden role="dialog" aria-modal="true" aria-label={`${album.title}: expanded photo`}>
      <div class="gallery-lightbox-backdrop" aria-hidden="true"></div>
      <div class="gallery-lightbox-frame"><img data-gallery-expanded src="" alt="" /></div>
      <div class="gallery-viewer-tools">
        <a class="gallery-icon" data-gallery-expanded-download href="#" aria-label="Download photo" title="Download photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></svg></a>
        <div class="gallery-menu-wrap" data-gallery-admin hidden>
          <button class="gallery-icon" type="button" data-gallery-menu-toggle aria-label="Photo options" aria-expanded="false" aria-controls="gallery-photo-menu" title="Photo options"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h.01M12 12h.01M19 12h.01" stroke-width="3.5" /></svg></button>
          <div class="gallery-photo-menu" id="gallery-photo-menu" data-gallery-menu hidden></div>
        </div>
        <button class="gallery-icon gallery-lightbox-close" type="button" data-gallery-close aria-label="Close photo" title="Close photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
      </div>
      <p class="gallery-viewer-status" data-gallery-viewer-status role="status" aria-live="polite"></p>
      <button class="gallery-lightbox-control gallery-lightbox-previous" type="button" data-gallery-previous aria-label="Previous photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></button>
      <button class="gallery-lightbox-control gallery-lightbox-next" type="button" data-gallery-next aria-label="Next photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg></button>
    </div>
  </main>
</BaseLayout>

<script>
  import '../../scripts/gallery-editor';
</script>
