  'r-r-greenhousse-52.jpg',
  'r-r-greenhousse-53.jpg',
  'r-r-greenhousse-54.jpg',
].filter(hasImage).map((filename) => {
  const photoNumber = filename.match(/-(\d+)\.jpg$/)?.[1];
  return {
    filename,
    alt: `Roots and Relics greenhouse, photo ${photoNumber}`,
  };
});
---

<BaseLayout
  title="Gallery | Roots & Relics Greenhouse"
  description="Photographs from Roots & Relics Greenhouse: previous gatherings, favorite antique pieces, seasonal installations, and life on the Southern Oregon farm."
  currentPath="/gallery/"
  bodyClass="gallery-page"
>
  <main id="main" class="gallery-main">
    <section class="gallery-hero" aria-labelledby="gallery-title">
      <figure class="gallery-hero-image" aria-hidden="true">
        <img src={imagePreviewUrl('r-r-greenhousse-1.jpg', { width: 1920, height: 1280, quality: 82 })} alt="" fetchpriority="high" />
      </figure>
      <div class="gallery-hero-shade" aria-hidden="true"></div>
      <div class="gallery-hero-content">
        <p class="kicker reveal">The gallery · Roots &amp; Relics</p>
        <h1 id="gallery-title" class="reveal">Imagine yourself <em>here.</em></h1>
      </div>
    </section>

    <section class="gallery-collection" aria-labelledby="gallery-collection-title">
      <header class="gallery-collection-heading reveal">
        <p class="kicker">Scenes from the greenhouse</p>
        <h2 id="gallery-collection-title">Previous gatherings, favorite pieces, seasonal installations, and <em>farm life.</em></h2>
      </header>

      <div class="gallery-grid">
        {galleryImages.map((image, index) => (
          <figure class="gallery-image reveal">
            <button type="button" data-gallery-item data-gallery-index={index} aria-label={`Open photo ${index + 1} of ${galleryImages.length}`}>
              <img
                src={imagePreviewUrl(image.filename)}
                data-full-src={imageUrl(image.filename)}
                alt={image.alt}
                loading="lazy"
                decoding="async"
              />
            </button>
          </figure>
        ))}
      </div>
    </section>

    <div class="gallery-lightbox" data-gallery-lightbox hidden role="dialog" aria-modal="true" aria-label="Expanded gallery photo">
      <div class="gallery-lightbox-backdrop" aria-hidden="true"></div>
      <div class="gallery-lightbox-frame">
        <img data-gallery-expanded src="" alt="" />
      </div>
      <button class="gallery-lightbox-close" type="button" data-gallery-close aria-label="Close expanded photo">
        <span></span><span></span>
      </button>
      <button class="gallery-lightbox-control gallery-lightbox-previous" type="button" data-gallery-previous aria-label="Previous photo">
        <span aria-hidden="true">←</span>
      </button>
      <button class="gallery-lightbox-control gallery-lightbox-next" type="button" data-gallery-next aria-label="Next photo">
        <span aria-hidden="true">→</span>
      </button>
    </div>

    <section class="gallery-invitation" aria-labelledby="gallery-invitation-title">
      <figure class="gallery-invitation-image">
        <img
          src={imagePreviewUrl('r-r-greenhousse-54.jpg', { width: 1600, height: 1200, quality: 80 })}
          alt="A recent scene from Roots and Relics Greenhouse"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="gallery-invitation-shade" aria-hidden="true"></div>
      <div class="gallery-invitation-copy reveal">
        <p class="kicker">Come see for yourself</p>
        <h2 id="gallery-invitation-title">The photographs never quite <em>do it.</em></h2>
        <a class="gallery-invitation-link" href="/before-you-visit/">Plan your visit <span>→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>
