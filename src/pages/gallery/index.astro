---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { imageUrl } from '../../lib/image-assets';
import { albums } from '../../data/gallery';
import '../../styles/gallery.css';
---

<BaseLayout
  title="Gallery | Roots & Relics Greenhouse"
  description="Photographs from Roots & Relics Greenhouse: previous gatherings, favorite antique pieces, seasonal installations, and life on the Southern Oregon farm."
  currentPath="/gallery/"
  bodyClass="gallery-page"
>
  <main id="main" class="gallery-main">
    <section class="gallery-hero" aria-labelledby="gallery-title">
      <figure class="gallery-hero-image" aria-hidden="true">
        <img src={imageUrl('r-r-greenhousse-1.jpg')} alt="" fetchpriority="high" />
      </figure>
      <div class="gallery-hero-shade" aria-hidden="true"></div>
      <div class="gallery-hero-content">
        <p class="kicker reveal">The gallery · Roots &amp; Relics</p>
        <h1 id="gallery-title" class="reveal">Imagine yourself <em>here.</em></h1>
      </div>
    </section>

    <section class="gallery-collection gallery-albums" aria-labelledby="gallery-albums-title">
      <header class="gallery-collection-heading reveal">
        <p class="kicker">Choose an album</p>
        <h2 id="gallery-albums-title">A gathering of <em>memories.</em></h2>
      </header>
      <div class="gallery-album-list">
        {albums.map((album) => (
          <a class="gallery-album-card reveal" data-gallery-album={album.slug} data-gallery-album-prefix={album.slug === 'greenhouse' ? 'r-r-greenhousse-' : 'r-r10-10-26-'} href={`/gallery/${album.slug}/`}>
            <img src={imageUrl(album.cover)} alt={album.coverAlt} loading="lazy" decoding="async" />
            <div class="gallery-album-copy">
              <p class="kicker">{album.subtitle} · <span data-gallery-count>{album.images.length} photos</span></p>
              <h3>{album.title}</h3>
              <span class="gallery-album-open">Explore album <span aria-hidden="true">→</span></span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="gallery-invitation" aria-labelledby="gallery-invitation-title">
      <figure class="gallery-invitation-image">
        <img
          src={imageUrl('r-r-greenhousse-54.jpg')}
          alt="A recent scene from Roots and Relics Greenhouse"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="gallery-invitation-shade" aria-hidden="true"></div>
      <div class="gallery-invitation-copy reveal">
        <p class="kicker">Come see for yourself</p>
        <h2 id="gallery-invitation-title">The photographs never quite <em>do it.</em></h2>
        <a class="gallery-invitation-link" href="/before-you-visit/">Plan your visit <span>→</span></a>
      </div>
    </section>
  </main>
</BaseLayout>

<script>
  const legacyAlbums: Record<string, string> = {
    '#october-gathering-2026': '/gallery/october-gathering-2026/',
    '#greenhouse-scenes': '/gallery/greenhouse/',
  };
  const album = legacyAlbums[window.location.hash];
  if (album) window.location.replace(album);
</script>

<script>
  import '../../scripts/gallery-editor';
</script>
