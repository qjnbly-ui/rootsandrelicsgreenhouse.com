---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import type { SitePath } from '../data/site';
import '../../styles.css';
import { fallGathering } from '../data/events';

interface Props {
  title: string;
  description: string;
  currentPath?: SitePath;
  bodyClass?: string;
}

const {
  title,
  description,
  currentPath = '/',
  bodyClass,
} = Astro.props;

const socialImage = 'https://vdbjlgmbpykjblprqnak.supabase.co/storage/v1/object/public/website-assets-public/65c78021-2652-4e64-b025-485262709d8a/957d6887-53df-4853-ac22-b1baf2f87ef5/v1-roots-relics-social-share-v2.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#26321e" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Roots &amp; Relics Greenhouse" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1800" />
    <meta property="og:image:height" content="945" />
    <meta property="og:image:alt" content="Roots &amp; Relics Greenhouse in Southern Oregon" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Roots &amp; Relics Greenhouse in Southern Oregon" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400&amp;family=DM+Sans:wght@400;500&amp;family=Newsreader:opsz,wght@6..72,300;6..72,400&amp;display=swap" rel="stylesheet" />
    <script is:inline>
      function webAnalyticsBeforeSend(event) {
        const isInternalDevice = document.cookie
          .split('; ')
          .some((cookie) => cookie === 'rr_analytics_opt_out=1');

        return isInternalDevice ? null : event;
      }

      const analyticsControlUrl = new URL(window.location.href);
      const analyticsSetting = analyticsControlUrl.searchParams.get('analytics');

      if (analyticsSetting === 'off') {
        document.cookie = 'rr_analytics_opt_out=1; Max-Age=31536000; Path=/; SameSite=Lax; Secure';
      } else if (analyticsSetting === 'on') {
        document.cookie = 'rr_analytics_opt_out=; Max-Age=0; Path=/; SameSite=Lax; Secure';
      }

      if (analyticsSetting === 'off' || analyticsSetting === 'on') {
        analyticsControlUrl.searchParams.delete('analytics');
        window.history.replaceState(
          {},
          '',
          `${analyticsControlUrl.pathname}${analyticsControlUrl.search}${analyticsControlUrl.hash}`,
        );
      }
    </script>
    <style is:global>
      [data-event-end][data-expired], [data-opening-end][data-expired],
      [data-after-event]:not([data-expired]) { display: none !important; }
    </style>
    <script is:inline define:vars={{ eventEnd: fallGathering.end }}>
      // Update static pages at visit time, without needing another deployment.
      function refreshGatheringDates() {
        const now = Date.now();
        const ended = now >= Date.parse(eventEnd);
        document.querySelectorAll('[data-event-end], [data-opening-end], [data-after-event]').forEach((element) => {
          const end = element.getAttribute('data-event-end') || element.getAttribute('data-opening-end') || element.getAttribute('data-after-event');
          element.toggleAttribute('data-expired', now >= Date.parse(end) && !(ended && element.hasAttribute('data-archive-opening')));
        });
        document.querySelectorAll('[data-remaining-date]').forEach((element) => {
          const days = JSON.parse(element.getAttribute('data-remaining-date')).filter((day) => now < Date.parse(day.end));
          const text = days.map((day) => `${day.day} · ${day.hours}`).join(' / ');
          if (element.textContent !== text) element.textContent = text;
        });
        document.querySelectorAll('[data-next-opening]').forEach((element) => {
          const day = JSON.parse(element.getAttribute('data-next-opening')).find((day) => now < Date.parse(day.end));
          const text = day ? `${day.day} · ${day.hours}` : '';
          if (element.textContent !== text) element.textContent = text;
        });
        document.querySelectorAll('[data-calendar-end]').forEach((element) => {
          const text = now >= Date.parse(element.getAttribute('data-calendar-end')) ? 'Past gathering' : 'Upcoming gathering';
          if (element.textContent !== text) element.textContent = text;
        });
        document.querySelectorAll('[data-event-archive]').forEach((element) => {
          if (ended && element.textContent !== element.getAttribute('data-event-archive')) element.textContent = element.getAttribute('data-event-archive');
        });
      }
      const gatheringObserver = new MutationObserver(refreshGatheringDates);
      gatheringObserver.observe(document.documentElement, { childList: true, subtree: true });
      document.addEventListener('DOMContentLoaded', () => {
        gatheringObserver.disconnect();
        refreshGatheringDates();
      });
      window.addEventListener('pageshow', refreshGatheringDates);
      document.addEventListener('visibilitychange', refreshGatheringDates);
      setInterval(refreshGatheringDates, 30000);
    </script>
    <Analytics />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header currentPath={currentPath} />
    <slot />
    <Footer />
    <script is:inline src="https://n3xra.com/client-portal/public-traffic-counter.js" defer></script>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
